---
import Layout from '../layouts/Layout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import FernAccent from '../components/FernAccent.astro';
import Bloom from '../components/Bloom.astro';

// ---- product data ----
// `image` points to /public/images/<file>.png. Files marked `placeholder: true`
// will render a soft "coming soon" placeholder until you drop in real artwork.

type Product = {
  id: string;
  name: string;
  description: string;
  price: string;
  unit?: string;
  image?: string;
  tag?: string;
  whatsappMessage: string;
  placeholder?: boolean;
};

const available: Product[] = [
  {
    id: 'tshirt-01',
    name: 'Eco-printed tee — design one',
    description: 'Soft cotton, printed with foraged leaves. Sizes M, L, XL.',
    price: '₹1,499',
    image: '/images/tshirt-01.png',
    tag: 'Ready to ship',
    placeholder: true,
    whatsappMessage: "Hi Florelle, I'd like to pre-order the eco-printed tee (design 1).",
  },
  {
    id: 'tshirt-02',
    name: 'Eco-printed tee — design two',
    description: 'Soft cotton, printed with foraged leaves. Sizes M, L, XL.',
    price: '₹1,499',
    image: '/images/tshirt-02.png',
    tag: 'Ready to ship',
    placeholder: true,
    whatsappMessage: "Hi Florelle, I'd like to pre-order the eco-printed tee (design 2).",
  },
  {
    id: 'tshirt-03',
    name: 'Eco-printed tee — design three',
    description: 'Soft cotton, printed with foraged leaves. Sizes M, L, XL.',
    price: '₹1,499',
    image: '/images/tshirt-03.png',
    tag: 'Ready to ship',
    placeholder: true,
    whatsappMessage: "Hi Florelle, I'd like to pre-order the eco-printed tee (design 3).",
  },
  {
    id: 'silk-scarf-01',
    name: 'Mulberry silk scarf — one',
    description: 'Pure mulberry silk, plant-printed by hand. One size.',
    price: '₹6,999',
    image: '/images/silk-scarf-01.png',
    tag: 'Ready to ship',
    placeholder: true,
    whatsappMessage: "Hi Florelle, I'd like to inquire about the mulberry silk scarf (design 1).",
  },
  {
    id: 'silk-scarf-02',
    name: 'Mulberry silk scarf — two',
    description: 'Pure mulberry silk, plant-printed by hand. One size.',
    price: '₹6,999',
    image: '/images/silk-scarf-02.png',
    tag: 'Ready to ship',
    placeholder: true,
    whatsappMessage: "Hi Florelle, I'd like to inquire about the mulberry silk scarf (design 2).",
  },
  {
    id: 'silk-scarf-03',
    name: 'Mulberry silk scarf — three',
    description: 'Pure mulberry silk, plant-printed by hand. One size.',
    price: '₹6,999',
    image: '/images/silk-scarf-03.png',
    tag: 'Ready to ship',
    placeholder: true,
    whatsappMessage: "Hi Florelle, I'd like to inquire about the mulberry silk scarf (design 3).",
  },
  {
    id: 'aloe-scarf',
    name: 'Aloe-fibre scarf',
    description: 'A whisper-light scarf in aloe fibre, dyed with native flora.',
    price: '₹3,999',
    image: '/images/aloe-scarf.png',
    tag: 'Ready to ship',
    placeholder: true,
    whatsappMessage: "Hi Florelle, I'd like to inquire about the aloe-fibre scarf.",
  },
  {
    id: 'satin-scarf',
    name: 'Satin scarf',
    description: 'Smooth satin with botanical print, soft to the touch.',
    price: '₹3,599',
    image: '/images/satin-scarf.png',
    tag: 'Ready to ship',
    placeholder: true,
    whatsappMessage: "Hi Florelle, I'd like to inquire about the satin scarf.",
  },
  {
    id: 'diary',
    name: 'Hand-bound botanical diary',
    description: 'Hand-bound, with a cover printed in foraged leaves.',
    price: '₹399',
    image: '/images/diary.png',
    tag: 'Ready to ship',
    placeholder: true,
    whatsappMessage: "Hi Florelle, I'd like to pre-order the hand-bound botanical diary.",
  },
];

const comingSoon: Product[] = [
  {
    id: 'pillow-covers',
    name: 'Pillow covers',
    description: 'Soft cotton, eco-printed in matched pairs. Made to order.',
    price: '₹999',
    placeholder: true,
    tag: 'Pre-order',
    whatsappMessage: "Hi Florelle, I'd like to pre-order the eco-printed pillow covers.",
  },
  {
    id: 'cushion-covers',
    name: 'Cushion covers',
    description: 'Layered prints on natural cotton. Made to order.',
    price: '₹799',
    placeholder: true,
    tag: 'Pre-order',
    whatsappMessage: "Hi Florelle, I'd like to pre-order the eco-printed cushion covers.",
  },
  {
    id: 'tote-bags',
    name: 'Canvas tote bags',
    description: 'Heavy canvas, leaf-printed. Carries the market and more.',
    price: '₹399',
    placeholder: true,
    tag: 'Pre-order',
    whatsappMessage: "Hi Florelle, I'd like to pre-order the canvas tote bags.",
  },
  {
    id: 'scrunchies',
    name: 'Scrunchies',
    description: 'Made from leftover silk and cotton. Nothing wasted.',
    price: '₹199',
    placeholder: true,
    tag: 'Pre-order',
    whatsappMessage: "Hi Florelle, I'd like to pre-order the scrunchies.",
  },
];

const description =
  'Florelle makes plant-printed scarves, tees and paper by hand — using leaves, flowers and roots foraged with care. Pre-order or inquire on WhatsApp.';
---
<Layout title="Florelle — plant-printed textiles & paper" description={description}>
  <header class="site-header">
    <div class="wrap">
      <a href="#top" class="brand" aria-label="Florelle home">
        <svg class="brand-mark" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <g fill="none" stroke="#3f4a3a" stroke-width="1.4" stroke-linecap="round">
            <path d="M16 4 V 28" />
            <path d="M16 10 C 11 8, 7 7, 5 9 C 7 12, 11 13, 16 12" fill="#c4d0b6" fill-opacity="0.6" />
            <path d="M16 10 C 21 8, 25 7, 27 9 C 25 12, 21 13, 16 12" fill="#c4d0b6" fill-opacity="0.6" />
            <path d="M16 16 C 11 14, 7 13, 5 15 C 7 18, 11 19, 16 18" fill="#c4d0b6" fill-opacity="0.5" />
            <path d="M16 16 C 21 14, 25 13, 27 15 C 25 18, 21 19, 16 18" fill="#c4d0b6" fill-opacity="0.5" />
            <path d="M16 22 C 12 20, 9 19, 7 21 C 9 24, 12 25, 16 24" fill="#c4d0b6" fill-opacity="0.4" />
            <path d="M16 22 C 20 20, 23 19, 25 21 C 23 24, 20 25, 16 24" fill="#c4d0b6" fill-opacity="0.4" />
          </g>
          <circle cx="16" cy="3.5" r="1.6" fill="#c99a82" />
        </svg>
        <span class="brand-name">Florelle<span class="brand-dot">.</span></span>
      </a>
      <nav class="nav" aria-label="Page sections">
        <a href="#story">Our story</a>
        <a href="#products">Pieces</a>
        <a href="#process">Process</a>
        <a href="#inquire">Inquire</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="hero" id="top">
      <div class="motif" style="top: 6%; left: -60px;">
        <FernAccent width={260} height={380} color="#94a380" rotate={-12} />
      </div>
      <div class="motif" style="bottom: -40px; right: -40px;">
        <FernAccent width={220} height={320} color="#c99a82" rotate={170} flip={true} />
      </div>

      <div class="wrap content">
        <p class="hero-eyebrow">Slow textiles, made by hand</p>
        <h1>
          Wear the garden,<br />
          carry the <em>quiet</em>.
        </h1>
        <p class="hero-lede measure">
          Florelle prints scarves, tees and paper using leaves, petals and roots foraged
          with care — pressed into cloth, set with steam, kept by hand. Every piece is a
          small love letter to the land it came from.
        </p>
        <div class="hero-actions">
          <WhatsAppButton variant="primary" label="Pre-order or inquire" />
          <a href="#products" class="btn btn-ghost">See the pieces</a>
        </div>
      </div>
    </section>

    <!-- ============ STORY ============ -->
    <section class="story" id="story">
      <div class="motif" style="top: 40px; right: -80px;">
        <FernAccent width={200} height={300} color="#94a380" rotate={20} flip />
      </div>

      <div class="wrap content">
        <div class="story-grid">
          <div>
            <p class="eyebrow">Our story</p>
            <h2>Made gently,<br />given freely.</h2>
            <p class="measure">
              We started with one question: what would it look like if a wardrobe took
              nothing from the world it lives in? Florelle is our answer — small batches,
              natural cloth, dye drawn from leaves we know by name, and a quiet refusal
              of waste.
            </p>
            <p class="measure">
              Every print is a real plant, pressed onto cloth and set with steam. No two
              are the same. Offcuts become scrunchies and diary covers. Nothing is hurt
              to make them; nothing is hurried.
            </p>
          </div>
          <div class="story-pillars">
            <div class="pillar">
              <span class="tag">Plant-printed</span>
              <h3>Real leaves, real petals</h3>
              <p>
                Foraged with permission and pressed onto fabric. The print is the plant
                itself — a soft fingerprint of the season.
              </p>
            </div>
            <div class="pillar">
              <span class="tag tag-blush">Considered</span>
              <h3>Small batches, slow runs</h3>
              <p>
                We make only what we can finish well. Pre-order opens, fills, and closes.
                You'll always know what's coming, and when.
              </p>
            </div>
            <div class="pillar">
              <span class="tag">Nothing wasted</span>
              <h3>Scraps become softness</h3>
              <p>
                Leftover silk and cotton turn into scrunchies, diary covers and small
                gifts. We send the whole tree home.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="divider" aria-hidden="true">
      <Bloom size={48} color="#c99a82" />
    </div>

    <!-- ============ PRODUCTS — READY TO SHIP ============ -->
    <section id="products">
      <div class="motif" style="top: 80px; left: -100px;">
        <FernAccent width={240} height={360} color="#94a380" rotate={-8} />
      </div>

      <div class="wrap content">
        <p class="eyebrow">Pieces, in season</p>
        <h2 class="measure">Each one made by hand,<br />finished, and ready to send.</h2>
        <p class="measure" style="color: var(--soft-ink); margin-bottom: 48px;">
          A small first run. When a piece is gone, it's gone — but tell us what you loved
          and we'll let you know when the next one is ready.
        </p>

        <div class="grid grid-3">
          {available.map((p) => (
            <article class="card">
              <div class="card-image">
                {p.image && !p.placeholder ? (
                  <img src={p.image} alt={p.name} loading="lazy" />
                ) : (
                  <span class="placeholder">Photograph coming soon</span>
                )}
              </div>
              <div class="card-body">
                {p.tag && <span class="card-eyebrow">{p.tag}</span>}
                <h3 class="card-title">{p.name}</h3>
                <p class="card-meta">{p.description}</p>
                <p class="card-price">{p.price}</p>
                <div class="card-cta">
                  <WhatsAppButton
                    variant="ghost"
                    label="Inquire on WhatsApp"
                    message={p.whatsappMessage}
                  />
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ PROCESS ============ -->
    <section class="process">
      <div class="wrap content">
        <p class="eyebrow">How it's made</p>
        <h2 class="measure">A slow, quiet method —<br />no shortcuts.</h2>
        <p class="measure" style="color: var(--soft-ink);">
          Eco-printing is an old craft that lets the plant do its own marking. Our
          process is patient by design.
        </p>

        <div class="steps">
          <div class="step">
            <p class="step-num">01</p>
            <h3>Forage with care</h3>
            <p>
              We gather leaves and petals locally — only what we need, and never from a
              plant that wouldn't notice it gone.
            </p>
          </div>
          <div class="step">
            <p class="step-num">02</p>
            <h3>Prepare the cloth</h3>
            <p>
              Cotton, silk, satin, aloe — washed, mordanted with kitchen-safe minerals,
              and laid out to receive the print.
            </p>
          </div>
          <div class="step">
            <p class="step-num">03</p>
            <h3>Press and steam</h3>
            <p>
              The plant is pressed into the fabric and rolled tight. Steam coaxes the
              pigment out, leaf by leaf, over hours.
            </p>
          </div>
          <div class="step">
            <p class="step-num">04</p>
            <h3>Rest and finish</h3>
            <p>
              We unroll, rinse and hang to cure. The cloth keeps a soft ghost of every
              leaf that touched it.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ COMING SOON ============ -->
    <section>
      <div class="wrap content">
        <p class="eyebrow">Opening soon</p>
        <h2 class="measure">Pieces we're making for the next run.</h2>
        <p class="measure" style="color: var(--soft-ink); margin-bottom: 40px;">
          Tell us which ones you'd like — we'll save you a place in the pre-order list.
        </p>

        <div class="grid grid-3">
          {comingSoon.map((p) => (
            <article class="card">
              <div class="card-image">
                <span class="placeholder">Photograph coming soon</span>
              </div>
              <div class="card-body">
                {p.tag && <span class="card-eyebrow">{p.tag}</span>}
                <h3 class="card-title">{p.name}</h3>
                <p class="card-meta">{p.description}</p>
                <p class="card-price">{p.price}</p>
                <div class="card-cta">
                  <WhatsAppButton
                    variant="ghost"
                    label="Add me to the list"
                    message={p.whatsappMessage}
                  />
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CUSTOM / WEDDING ============ -->
    <section id="inquire">
      <div class="wrap content">
        <div class="callout">
          <div class="motif" style="bottom: -40px; right: -40px;">
            <FernAccent width={240} height={340} color="#94a380" rotate={185} flip />
          </div>
          <div class="content">
            <p class="eyebrow">Custom & wedding souvenirs</p>
            <h2>For the days you'll remember.</h2>
            <p style="color: var(--soft-ink); max-width: 52ch;">
              Wedding favours, named scarves, a tee with your team's leaf on it. Tell us
              what you'd like — we'll quote, sketch, and start. Custom runs from
              ₹8,999.
            </p>
            <WhatsAppButton
              variant="primary"
              label="Start a custom inquiry"
              message="Hi Florelle, I'd like to discuss a custom order or wedding souvenirs."
            />
          </div>
          <div class="content" style="text-align: right;">
            <Bloom size={140} color="#c99a82" />
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="site-footer">
    <div class="motif" style="top: -40px; left: -40px;">
      <FernAccent width={260} height={380} color="#fbf6ee" rotate={-15} />
    </div>
    <div class="motif" style="bottom: -60px; right: -60px;">
      <FernAccent width={240} height={340} color="#fbf6ee" rotate={170} flip />
    </div>

    <div class="wrap content">
      <div style="max-width: 56ch;">
        <p class="eyebrow" style="color: var(--terracotta-soft);">Stay close</p>
        <h2>Want to know when the next run opens?</h2>
        <p style="opacity: 0.85;">
          Drop us a message on WhatsApp. We'll add you to the small, quiet list and
          let you know when fresh pieces are ready.
        </p>
        <WhatsAppButton variant="wa" label="Message us on WhatsApp" />
      </div>

      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Florelle. Made with care in India.</span>
        <span>Slow textiles, considered always.</span>
      </div>
    </div>
  </footer>

  <!-- ============ FLOATING CTA ============ -->
  <WhatsAppButton variant="float" label="Pre-order" />
</Layout>
