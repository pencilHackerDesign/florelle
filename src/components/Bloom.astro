---
// A subtle small bloom — used as a divider / accent.
export interface Props {
  size?: number;
  color?: string;
}
const { size = 56, color = '#c99a82' } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 56 56"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <g fill="none" stroke={color} stroke-width="1.2" stroke-linecap="round">
    <path d="M28 6 C 24 14, 24 22, 28 28 C 32 22, 32 14, 28 6 Z" fill={color} fill-opacity="0.18" />
    <path d="M50 28 C 42 24, 34 24, 28 28 C 34 32, 42 32, 50 28 Z" fill={color} fill-opacity="0.18" />
    <path d="M28 50 C 24 42, 24 34, 28 28 C 32 34, 32 42, 28 50 Z" fill={color} fill-opacity="0.18" />
    <path d="M6 28 C 14 24, 22 24, 28 28 C 22 32, 14 32, 6 28 Z" fill={color} fill-opacity="0.18" />
    <circle cx="28" cy="28" r="3" fill={color} stroke="none" />
  </g>
</svg>
