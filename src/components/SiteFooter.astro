---
import MotifLeaf from './MotifLeaf.astro';
import InquireButton from './InquireButton.astro';
import { GENERIC_INQUIRE_MESSAGE } from '../lib/whatsapp';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="page">
    <div class="footer__cta">
      <h2 class="footer__credo">
        A small studio,<br />
        a <em>slow</em> practice.<br />
        One conversation at a time.
      </h2>
      <InquireButton message={GENERIC_INQUIRE_MESSAGE} />
    </div>
    <div class="footer__base">
      <div class="footer__credits">
        <a href="#main" class="brand" aria-label="Florelle">
          <MotifLeaf fillOpacity={0.18} />
          <span class="brand__name">Florelle</span>
        </a>
        <span class="footer__one-line">Plant-printed in India.</span>
        <span class="footer__one-line">Identity by Sharpener Design.</span>
      </div>
      <span>© {year} Florelle Studio</span>
    </div>
  </div>
</footer>
