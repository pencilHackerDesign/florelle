    <circle cx="16" cy="16" r="2.2" fill="currentColor" fill-opacity="0.5" />
    <path d="M16 14 C 14 9, 10 8, 8 12 C 10 14, 14 14, 16 14 Z" fill="currentColor" fill-opacity="0.18" />
    <path d="M16 14 C 18 9, 22 8, 24 12 C 22 14, 18 14, 16 14 Z" fill="currentColor" fill-opacity="0.18" />
    <path d="M16 18 C 14 23, 10 24, 8 20 C 10 18, 14 18, 16 18 Z" fill="currentColor" fill-opacity="0.18" />
    <path d="M16 18 C 18 23, 22 24, 24 20 C 22 18, 18 18, 16 18 Z" fill="currentColor" fill-opacity="0.18" />
  </g>
</svg>
