---
import { inquireUrl } from '../lib/whatsapp';

interface Props {
  message: string;
  variant?: 'solid' | 'ghost';
  label?: string;
  ariaLabel?: string;
  class?: string;
  withGlyph?: boolean;
}

const {
  message,
  variant = 'solid',
  label = 'Inquire on WhatsApp',
  ariaLabel,
  class: className = '',
  withGlyph = true,
} = Astro.props;

const href = inquireUrl(message);
const classes = ['inquire'];
if (variant === 'ghost') classes.push('inquire--ghost');
if (className) classes.push(className);
---
<a
  href={href}
  class={classes.join(' ')}
  aria-label={ariaLabel ?? label}
  rel="noopener"
>
  {withGlyph && (
    <svg class="wa-glyph" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.7 1.4 5.3L2 22l4.8-1.3C8.3 21.5 10.1 22 12 22c5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18c-1.7 0-3.3-.5-4.7-1.3l-.3-.2-2.9.8.8-2.8-.2-.3C3.8 14.7 3.3 13.4 3.3 12 3.3 7.2 7.2 3.3 12 3.3S20.7 7.2 20.7 12 16.8 20 12 20zm5.3-5.9c-.3-.1-1.7-.8-2-.9s-.5-.1-.7.1c-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1s-1.2-.5-2.3-1.4c-.9-.7-1.4-1.7-1.6-1.9-.2-.3 0-.4.1-.5l.4-.5c.1-.2.2-.3.3-.5s.1-.3 0-.5-.7-1.7-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.3-.3.3-1 1-1 2.4s1.1 2.8 1.2 3c.1.2 2.1 3.2 5.1 4.4.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.5-.3z"/>
    </svg>
  )}
  {label}
</a>
