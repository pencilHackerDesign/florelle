---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Florelle. Plant-printed scarves & tees, made by hand.',
  description = 'Florelle is a small studio in India making plant-printed scarves and t-shirts. The print is the plant itself, pressed into cloth and steamed over hours.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7efe2" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,400&family=Hanken+Grotesk:wght@300;400;500;600&display=swap"
    />
  </head>
  <body data-screen-label="Florelle Launch Page">
    <a href="#main" class="skip">Skip to content</a>
    <slot />
    <Analytics />
  </body>
</html>
